# Validation
msgid "Title is required."
msgstr "शीर्षक आवश्यक है।"

msgid "Title must be at least 5 characters long."
msgstr "शीर्षक कम से कम 5 अक्षरों का होना चाहिए।"

msgid "Description is required."
msgstr "विवरण आवश्यक है।"

msgid "Description must be at least 10 characters long."
msgstr "विवरण कम से कम 10 अक्षरों का होना चाहिए।"

msgid "Due date cannot be in the past."
msgstr "अंतिम तिथि भूतकाल में नहीं हो सकती।"

